# OmniLang environment configuration (copy to .env and fill in)

# --- Server ---
PORT=8080
# Public base URL of the catalog (used to build shareable listing links)
CATALOG_BASE_URL=https://omnilang.example.com
# "memory" (default, prototype) or "firestore" (Google Cloud)
OMNILANG_PERSISTENCE=memory
# Set to true to run the full flow with deterministic in-process adapters
# (no cloud credentials needed) — ideal for demos and local development.
OMNILANG_DEMO_MODE=false

# --- Google Cloud (Gemini via Vertex AI or API key, Firestore, Storage) ---
GCP_PROJECT=
GCP_LOCATION=us-central1
# Optional: use an API key instead of Vertex AI service account
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GOOGLE_CLOUD_STORAGE_BUCKET=

# --- WhatsApp Business Cloud API ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# --- LINE Messaging API ---
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# --- Payments gateway (generic invoice API) ---
# POST {PAYMENTS_API_URL}/invoices -> { invoiceId, paymentUrl }
PAYMENTS_API_URL=

# --- Registered merchants (JSON array) ---
# Example: MERCHANTS_JSON=[{"id":"m-001","displayName":"Warung Sari","language":"id","currency":"IDR","channel":"whatsapp","address":"6281234567890"}]
MERCHANTS_JSON=[]

# --- FX rates (target units per 1 IDR; indicative values, override for production) ---
FX_RATES_JSON={"USD":0.000064,"JPY":0.01,"SGD":0.000084,"PHP":0.0033,"INR":0.0054,"VND":0.16}
